# ============================================================
# VVR-Scraper Environment Variables
# Copy file này thành .env và điền API keys của bạn:
#   cp .env.example .env
# ============================================================

# --- Port cho Web UI ---
VVR_PORT=8000

# --- API Keys (BẮT BUỘC cho Audio Drama / Video) ---
OPENAI_API_KEY=sk-your-openai-key
ELEVENLABS_API_KEY=your-elevenlabs-key

# --- AI Script Parser ---
VVR_API_KEY=your-api-key
VVR_BASE_URL=https://api.openai.com/v1
VVR_MODEL=gpt-4o-mini

# --- Freesound (TÙY CHỌN - cho BGM/SFX) ---
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=

# --- SSR Proxy (TÙY CHỌN) ---
VVR_SSR_URL=val-ssr-2kzit.ondigitalocean.app

# --- OPDS Authentication ---
VVR_OPDS_USER=admin
VVR_OPDS_PASS=change-this-password

# --- Narrator Voice (TÙY CHỌN) ---
VVR_NARRATOR_VOICE_ID=ywBZEqUhld86Jeajq94o

# --- Auto Sync (0=tắt, 1=bật kiểm tra chương mới mỗi giờ) ---
VVR_AUTO_SYNC=0

# --- Social Reader Auth ---
VVR_JWT_SECRET=change-this-random-secret
VVR_ADMIN_CODE=bootstrap-admin-code

# --- TTS Provider Selection (optional, defaults to auto-detect) ---
# VVR_TTS_PROVIDER=elevenlabs

# --- OpenAI TTS (optional, for openai_tts provider) ---
# OPENAI_TTS_API_KEY=your_openai_key
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1

# --- OmniVoice local TTS (optional) ---
# OMNIVOICE_MODEL_PATH=/path/to/omnivoice/model
# VVR_OMNIVOICE_DEVICE=cuda:0

# --- Voice Bank (optional) ---
# VVR_VOICE_BANK_DIR=/path/to/voice/bank

# --- Audio Drama Narrator Reference Audio (optional) ---
# VVR_NARRATOR_REF_AUDIO=/path/to/narrator_ref.wav

# --- Logging (optional, 1=JSON format) ---
# VVR_LOG_JSON=1

# --- Playwright Mode (optional) ---
# VVR_PLAYWRIGHT_MODE=headless
